PORT=3001
# Where the sales team's enquiries are delivered
SALES_INBOX=sales@example.com
MAIL_FROM=catalogue@example.com
# "smtp" sends via SMTP_*, "console" just logs the email (no infrastructure needed)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave blank for Mailpit / local dev
SMTP_USER=
SMTP_PASS=
# Product data source: only "fakestore" exists today
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
# Comma-separated browser origins allowed to call the API (not needed behind the proxy)
CORS_ORIGINS=http://localhost:5173
